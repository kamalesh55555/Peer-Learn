generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. AUTHENTICATION & USERS
// ==========================================
model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  name           String
  password       String?          // Nullable for Google Sign-In users
  googleId       String?          @unique
  suspended      Boolean          @default(false) // Triggered if reported >= 3 times

  resources      Resource[]
  ratings        ResourceRating[]
  reports        Report[]
  hostedSessions LiveSession[]

  createdAt      DateTime         @default(now())
}

// ==========================================
// 2. CURRICULUM HIERARCHY (From your PDF)
// ==========================================
model University {
  id        Int       @id @default(autoincrement())
  name      String    @unique // e.g., "SRM Institute of Science and Technology"
  code      String    @unique // e.g., "SRM KTR", "ANNA UNIV"
  subjects  Subject[]
  createdAt DateTime  @default(now())
}

model Subject {
  id           Int              @id @default(autoincrement())
  code         String           // e.g., "21CSE354T", "CS3301"
  name         String           // e.g., "Full Stack Web Development"
  programme    String           // e.g., "B.Tech", "B.E"
  department   String           // e.g., "CSE", "ECE", "MECH"
  regulation   String           // e.g., "R2021", "R2018"
  semester     Int              // e.g., 1, 2, 3, 4, 5
  category     String?          // e.g., "Professional Core", "Professional Elective"
  credits      Int?             // e.g., 3, 4

  universityId Int
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)

  resources    Resource[]
  sessions     LiveSession[]

  createdAt    DateTime         @default(now())

  @@unique([universityId, code, regulation])
}

// ==========================================
// 3. STUDY MATERIALS & MODERATION
// ==========================================
model Resource {
  id         Int              @id @default(autoincrement())
  title      String           // Name of the uploaded file/notes
  fileUrl    String           // Path or URL to access the file
  hidden     Boolean          @default(false) // Auto-hidden if reports >= 3

  subjectId  Int
  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  uploaderId Int
  uploader   User             @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  ratings    ResourceRating[]
  reports    Report[]

  createdAt  DateTime         @default(now())
}

model ResourceRating {
  id         Int      @id @default(autoincrement())
  isHelpful  Boolean  // true = Upvote, false = Downvote

  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId]) // A user can only rate a resource once
}

model Report {
  id         Int      @id @default(autoincrement())
  reason     String   // e.g., "Irrelevant file", "Wrong Subject"

  resourceId Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId]) // A user can only report a resource once
}

// ==========================================
// 4. PEER MENTORING & LIVE SESSIONS
// ==========================================
model LiveSession {
  id        Int      @id @default(autoincrement())
  topic     String
  date      String   // e.g., "2026-10-15"
  time      String   // e.g., "18:00"
  meetLink  String   // Static Google Meet link

  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  hostId    Int
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}